# Gemini API key used by /api/chat for RAG embeddings + generation.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq fallback for generation when Gemini is down or rate-limited.
# Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional Groq model override. Defaults to openai/gpt-oss-120b.
# See https://console.groq.com/docs/models and https://console.groq.com/docs/deprecations
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Distributed per-IP rate limit (20 req / 10 min). Without these, only a
# per-instance cap applies — it does not span serverless isolates.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Resend API key used by /api/contact to send contact-form email.
# Create one at https://resend.com/api-keys
RESEND_API_KEY=

# Optional: override contact email routing.
# CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
# CONTACT_TO_EMAIL=mikencube03@gmail.com
